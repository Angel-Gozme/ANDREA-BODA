      const T="Por el bosque, el agua, las flores y el viento… ¡devolvemos la vida! Griselda se transforma en una pequeña semilla.";let i=0;if(reduce)ch.textContent=T;else(function w(){ch.textContent=T.slice(0,++i);if(i<T.length)setTimeout(w,34)})()},900);
