      const gr=g.createRadialGradient(x,y,0,x,y,f.r*5);gr.addColorStop(0,`rgba(255,225,140,${a})`);gr.addColorStop(1,"rgba(255,225,140,0)");g.fillStyle=gr;g.beginPath();g.arc(x,y,f.r*5,0,7);g.fill()}})()})();
