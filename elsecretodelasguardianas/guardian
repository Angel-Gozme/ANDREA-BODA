(()=>{const c=$("fire"),g=c.getContext("2d");let F=[],vis=true;
  const rs=()=>{c.width=c.clientWidth*dpr;c.height=c.clientHeight*dpr};rs();addEventListener("resize",rs);
  for(let i=0;i<34;i++)F.push({x:Math.random(),y:Math.random()*.85,s:.0003+Math.random()*.0007,p:Math.random()*6,r:1.5+Math.random()*2.4});
  new IntersectionObserver(e=>vis=e[0].isIntersecting).observe(c);
