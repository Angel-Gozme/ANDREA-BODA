<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>El secreto de las Guardianas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
<style>
/* Mismo universo pastel de la web original: puertas en arco, cielo suave, piscina de luz. 
   Añadido: puertas que recuerdan tu visita, portal con zoom y destellos, pasos interactivos por plataforma. */
:root{
  color-scheme:light;
  --sky1:#e3ebf7;--sky2:#e8eaf4;--sky3:#f6efe2;--ink:#3b3b5c;--soft:#5d5c80;
  --pool1:#cfdced;--pool2:#b6c8e2;--pool3:#a4b6d8;--paper:#fbfaf6;--line:#d9d6e6;
  --sans:"Poppins","Helvetica Neue",Arial,sans-serif;--serif:"Cormorant Garamond",Georgia,serif;
} 
html{scroll-padding-top:70px;scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--paper);color:var(--ink);font-family:var(--sans);overflow-x:hidden}
body.zooming{overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--ink);outline-offset:5px}
[hidden]{display:none!important}

/* ---------- Inicio ---------- */
.scene{--px:0;--py:0;--v:0;position:relative;z-index:5;min-height:100svh;display:grid;grid-template-rows:auto auto 1fr;justify-items:center;overflow:hidden;
  background:radial-gradient(55% 16% at 15% 30%,rgba(255,255,255,.6),transparent 70%),radial-gradient(45% 14% at 88% 42%,rgba(255,255,255,.5),transparent 70%),linear-gradient(180deg,var(--sky1),var(--sky2) 55%,var(--sky3))}
.halo{position:absolute;left:50%;top:50%;width:calc(62vmin + var(--v)*7vmin);height:calc(62vmin + var(--v)*7vmin);border-radius:50%;background:radial-gradient(circle,rgba(250,236,190,calc(.85 + var(--v)*.04)),transparent 68%);transform:translate(calc(-50% + var(--px)*-16px),calc(-50% + var(--py)*-10px));transition:transform .8s ease-out,width 1.2s,height 1.2s}
#fire{position:absolute;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
.top{width:100%;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;padding:.9rem clamp(1rem,3vw,2.5rem);padding-left:max(1rem,env(safe-area-inset-left,0px));padding-right:max(1rem,env(safe-area-inset-right,0px));position:relative;z-index:3}
.top .logo{height:46px;width:auto}
nav{display:flex;gap:.1rem;flex-wrap:wrap}
nav button{background:none;border:0;color:var(--soft);font:400 .88rem var(--sans);padding:.45rem .75rem;border-radius:999px;transition:background .25s,color .25s}
nav button:hover{background:rgba(255,255,255,.7);color:var(--ink)}
.intro{text-align:center;padding:.4rem 1.2rem 0;position:relative;z-index:3;max-width:1000px}
h1{margin:0;font:600 clamp(2.7rem,7.2vw,5.8rem)/1.02 var(--sans);letter-spacing:-.035em;text-wrap:balance}
.intro .lead{margin:.9rem auto 0;font:italic 500 clamp(1.3rem,2.4vw,1.85rem)/1.25 var(--serif);color:var(--soft);max-width:34em;text-wrap:balance}
.intro .how{margin:.7rem 0 0;font:400 clamp(.9rem,1.3vw,1.05rem) var(--sans)}
.count{margin:.5rem 0 0;font:500 .85rem var(--sans);color:var(--soft);display:inline-flex;align-items:center;gap:.5rem;background:rgba(255,255,255,.6);padding:.3rem .9rem;border-radius:999px;transition:background .6s}
.count.all{background:rgba(255,238,180,.85);color:var(--ink)}

.arches{align-self:end;display:flex;gap:clamp(.8rem,2.6vw,2.4rem);align-items:flex-end;justify-content:center;padding:1.2rem 1rem 15vh;position:relative;z-index:2;
  transform:translate(calc(var(--px)*7px),calc(var(--py)*3px));transition:transform .6s ease-out}
.arch{--mx:50%;--my:40%;appearance:none;position:relative;width:clamp(135px,min(18vw,21vh),235px);aspect-ratio:1/2.1;
  border:1.5px solid var(--c);border-bottom:0;border-radius:999px 999px 0 0;
  background:rgba(255,255,255,.4);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);
  display:flex;flex-direction:column;justify-content:space-between;align-items:center;text-align:center;padding:clamp(2.2rem,3.6vw,3.2rem) .7rem .9rem;
  -webkit-box-reflect:below 2px linear-gradient(rgba(255,255,255,.3),transparent 40%);
  transition:transform .4s ease,box-shadow .4s ease,background .4s ease,opacity .5s ease;
  animation:rise 1.1s cubic-bezier(.2,.8,.2,1) backwards;animation-delay:calc(.2s + var(--i)*.2s)}
.arch:nth-child(2),.arch:nth-child(3){margin-bottom:1.2rem}
.arch::after{content:"";position:absolute;left:-10px;right:-10px;bottom:-2px;height:2px;background:var(--c)}
.arch:hover,.arch:focus-visible,.arch.lit{transform:translateY(-8px);
  background:radial-gradient(circle at var(--mx) var(--my),rgba(255,255,255,.9),transparent 58%),linear-gradient(180deg,var(--cl),rgba(255,255,255,.3));
  box-shadow:0 0 46px var(--c),inset 0 0 28px rgba(255,255,255,.7)}
.arches:has(.arch:hover) .arch:not(:hover):not(.lit){opacity:.65}
.seal{position:absolute;top:8%;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;border:1.5px solid var(--c);background:transparent;transition:.6s}
.arch.vis .seal{background:var(--c);box-shadow:0 0 14px 3px var(--c)}
.q{font:italic 600 clamp(1rem,1.5vw,1.55rem)/1.1 var(--serif);text-wrap:balance}
.ai{flex:1;min-height:0;width:88%;object-fit:contain;margin:.4rem 0;filter:drop-shadow(0 8px 8px rgba(60,50,120,.25));transition:transform .5s}
.arch:hover .ai{transform:scale(1.07) translateY(-3px)}
.l{font:500 .95rem var(--sans);padding-bottom:.25rem;border-bottom:2px solid var(--c)}
@keyframes rise{from{opacity:0;transform:translateY(36px)}}
.pool{position:absolute;left:0;right:0;bottom:0;height:19vh;z-index:0;overflow:hidden;background:linear-gradient(180deg,var(--pool1),var(--pool2) 40%,var(--pool3));
  border-radius:50% 50% 0 0/26px 26px 0 0;box-shadow:0 -4px 22px rgba(255,255,255,.7);transform:translate(calc(var(--px)*-9px),0);transition:transform .6s ease-out}
.pool i{position:absolute;width:3px;height:3px;border-radius:50%;background:#fff;opacity:.8}
.pool i.t{animation:tw 4s ease-in-out infinite}
@keyframes tw{50%{opacity:.15}}
.scene.zoom{transform:scale(9);transition:transform 1.25s cubic-bezier(.5,.05,.85,.35)}
.scene.zoom .arch:not(.lit),.scene.zoom .intro,.scene.zoom .top{opacity:0;transition:opacity .4s}
.scene.zoom .arch{pointer-events:none}
#veil{position:fixed;inset:0;z-index:60;pointer-events:none;opacity:0;background:radial-gradient(circle at 50% 50%,#fff 0,var(--vc,#fff) 70%);transition:opacity .9s ease}
#veil.on{opacity:1;transition:opacity .5s ease .7s}
#veil.quick{transition:opacity .45s ease}
.ring{position:fixed;z-index:61;width:30px;height:30px;margin:-15px 0 0 -15px;border:3px solid var(--c);border-radius:50%;pointer-events:none;animation:ring 1.1s ease-out forwards}
@keyframes ring{to{transform:scale(70);opacity:0;border-width:1px}}
.arrive{animation:arrive .95s cubic-bezier(.2,.7,.2,1) both}
@keyframes arrive{from{opacity:0;transform:scale(1.12)}}
.back{animation:backin .8s ease both}
@keyframes backin{from{opacity:0;transform:scale(1.15)}}

/* ---------- Formas con imagen ---------- */
.art{position:relative;isolation:isolate;margin:0}
.art::before{content:"";position:absolute;inset:7% -5% -5% 9%;background:var(--c);border-radius:62% 38% 46% 54%/50% 60% 40% 50%;z-index:-1;transform:rotate(-6deg);transition:transform .8s cubic-bezier(.2,.8,.2,1),border-radius .8s}
.art:hover::before{transform:rotate(4deg) scale(1.03);border-radius:42% 58% 55% 45%/58% 42% 58% 42%}
.art::after{content:"";position:absolute;width:26%;aspect-ratio:1;right:-4%;top:-5%;background:var(--cl);border:2px solid var(--c);border-radius:50%;z-index:-1;animation:bob 6s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(10px) scale(1.06)}}
.art img{display:block;width:100%;max-width:100%;height:auto;transition:transform .35s ease-out,box-shadow .35s;transform:perspective(800px) rotateY(calc(var(--tx,0)*7deg)) rotateX(calc(var(--ty,0)*-5deg))}
.art.photo img{border-radius:var(--sh,58% 42% 55% 45%/48% 56% 44% 52%);box-shadow:0 18px 38px rgba(60,50,120,.22);cursor:zoom-in}
.art.photo:hover img{box-shadow:0 26px 50px rgba(60,50,120,.3)}
.art.cut img{filter:drop-shadow(0 14px 14px rgba(60,50,120,.28));animation:flt 7s ease-in-out infinite}
@keyframes flt{50%{translate:0 -8px}}
.art.mono{aspect-ratio:1;display:grid;place-items:center;font:600 7rem var(--sans);color:#fff}
.gal{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1rem,3vw,2rem);grid-column:1/-1;margin-top:1rem}
.gal .art:nth-child(2){margin-top:2rem}

/* Puerta (hero de cada plataforma) */
.gate{--ar:4/5;position:relative;width:min(100%,430px);margin-inline:auto;aspect-ratio:var(--ar);padding:10px;border-radius:999px 999px 30px 30px;background:linear-gradient(180deg,var(--c),var(--cl));
  box-shadow:0 0 0 1.5px var(--c),0 30px 60px rgba(60,50,120,.25),0 0 90px color-mix(in srgb,var(--c) 60%,transparent);
  transform:perspective(900px) rotateY(calc(var(--tx,0)*8deg)) rotateX(calc(var(--ty,0)*-6deg));transition:transform .3s ease-out}
.gate .in{position:relative;width:100%;height:100%;overflow:hidden;border-radius:999px 999px 22px 22px;background:radial-gradient(circle at 50% 30%,#fff,var(--cl) 75%)}
.gate img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.06) translate(calc(var(--tx,0)*-8px),calc(var(--ty,0)*-6px));transition:transform .4s ease-out}
.gate.cut img{object-fit:contain;padding:7%;filter:drop-shadow(0 12px 12px rgba(60,50,120,.3))}
.gate .in::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.55) 50%,transparent 65%);transform:translateX(-120%);animation:shine 5.5s ease-in-out 1.2s infinite}
@keyframes shine{40%,100%{transform:translateX(120%)}}
.gate .tw{position:absolute;width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 14px 4px var(--c);animation:tw 3s ease-in-out infinite}

/* ---------- Universo (inicio) ---------- */
.uni{background:var(--paper)}
.blk{max-width:1100px;margin:0 auto;padding:clamp(3rem,8vw,6rem) clamp(1.2rem,6vw,3rem) 0}
.blk>h2{margin:0 0 1.2rem;font:600 clamp(1.8rem,3.6vw,2.8rem)/1.1 var(--sans);letter-spacing:-.02em;text-wrap:balance}
.blk>.in{font:500 1.3rem/1.6 var(--serif);max-width:72ch}
.two{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);align-items:center}
.two p,.tx p{font:500 1.3rem/1.6 var(--serif);margin:0 0 .9rem;max-width:70ch}
.quote{font:italic 600 clamp(1.6rem,3vw,2.4rem)/1.2 var(--serif);margin:1.4rem 0 0;padding-left:1.2rem;border-left:3px solid #a8cdb9}
.sheet{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:clamp(1.5rem,5vw,4rem);align-items:center;margin:clamp(2.5rem,6vw,4.5rem) 0}
.sheet.alt{grid-template-columns:minmax(0,1.4fr) minmax(0,.8fr)}.sheet.alt .art{order:2}
.sheet h3{margin:0;font:600 clamp(1.5rem,2.6vw,2rem) var(--sans);letter-spacing:-.01em}
.role{font:italic 500 1.3rem var(--serif)!important;color:var(--soft);margin:.1rem 0 .8rem!important}
.ent{display:grid;grid-template-columns:minmax(120px,200px) 1fr auto;gap:1rem 2rem;align-items:baseline;padding:1rem 0;border-bottom:1px solid var(--line)}
.ent b{font:600 1.1rem var(--sans)}.ent span{font:500 1.25rem/1.5 var(--serif)}
.ent button{background:var(--ink);color:#fff;border:0;border-radius:999px;padding:.5rem 1.2rem;font:500 .88rem var(--sans);transition:transform .2s}
.ent button:hover{transform:translateX(4px)}
.ent b::before{content:"";display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.6rem;background:var(--c);box-shadow:0 0 0 0 var(--c);transition:.5s}
.ent.vis b::before{box-shadow:0 0 10px 3px var(--c)}
details.nt{margin:3rem 0;border-top:1px solid var(--line);padding-top:1rem}
details.nt summary{font:500 .95rem var(--sans);cursor:pointer}
details.nt li{font:500 1.2rem/1.5 var(--serif);margin:.4rem 0}
dl{display:grid;grid-template-columns:minmax(110px,190px) 1fr;gap:.8rem 1.6rem;margin:0}
dt{font:500 .85rem var(--sans);color:var(--soft);padding-top:.4rem}
dd{margin:0;font:500 1.25rem/1.55 var(--serif)}

/* ---------- Páginas de plataforma ---------- */
.page{background:linear-gradient(180deg,var(--cl),#fff 38%,var(--paper));min-height:100svh;padding-bottom:3rem}
#prog{position:fixed;top:0;left:0;height:3px;width:0;z-index:30;background:var(--pc,var(--ink))}
.bar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:.6rem clamp(1rem,3vw,2.5rem);padding-left:max(1rem,env(safe-area-inset-left,0px));padding-right:max(1rem,env(safe-area-inset-right,0px));background:rgba(255,255,255,.8);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--c)}
.bar .logo{height:38px;width:auto}
.bar>button{background:none;border:0;font:500 .9rem var(--sans);text-decoration:underline;padding:.4rem}
.mini{display:inline-flex;align-items:center;gap:.45rem}
.mini::before{content:"";width:11px;height:16px;border-radius:99px 99px 0 0;border:1.5px solid var(--c);background:var(--cl)}
.mini:hover::before{background:var(--c)}
.hero{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);align-items:center;padding:clamp(2.5rem,6vw,4.5rem) clamp(1.2rem,6vw,3rem) 1rem}
.hero h1{font-size:clamp(2.2rem,5.2vw,4.2rem);letter-spacing:-.03em}
.hero .sub{margin:.6rem 0 0;font:italic 500 clamp(1.4rem,2.4vw,1.9rem) var(--serif);color:var(--soft)}
.hero .lede{margin:1.3rem 0 0;font:500 clamp(1.25rem,1.9vw,1.45rem)/1.6 var(--serif);max-width:60ch}
.hero .door{display:inline-flex;align-items:center;gap:.6rem;font:500 .8rem var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--soft);margin-bottom:1rem}
.hero .door::before{content:"";width:14px;height:20px;border-radius:99px 99px 0 0;border:2px solid var(--c);background:var(--cl);box-shadow:0 0 14px var(--c)}
.ha{position:relative}
.ha .over{position:absolute;left:-6%;bottom:-6%;width:34%;z-index:3}
.sec{max-width:1100px;margin:0 auto;padding:clamp(2rem,5vw,3.6rem) clamp(1.2rem,6vw,3rem) 0}
.sec.has{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);align-items:center}
.sec.has.alt{grid-template-columns:minmax(0,1fr) minmax(0,1.5fr)}.sec.alt .art{order:-1}
.sec h2{margin:0 0 1rem;font:500 clamp(1.3rem,2.2vw,1.7rem) var(--sans);display:inline-block;border-bottom:3px solid var(--c);padding-bottom:.2rem}
.sec ul,.sec ol{margin:0;padding-left:1.4rem;font:500 1.3rem/1.6 var(--serif)}
.sec .big{font:italic 600 clamp(1.5rem,2.8vw,2.1rem)/1.25 var(--serif);border-left:4px solid var(--c);padding-left:1.1rem;max-width:34em}
.sec .tx>p{font:500 1.3rem/1.6 var(--serif);max-width:70ch}
.pf{max-width:1100px;margin:3rem auto 0;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:0 clamp(1.2rem,6vw,3rem)}
.pf button{background:var(--ink);color:#fff;border:0;border-radius:999px;padding:.7rem 1.5rem;font:500 .92rem var(--sans)}
.pf button:last-child{background:none;color:var(--ink);text-decoration:underline}
.idx{position:fixed;right:max(14px,env(safe-area-inset-right,0px));top:50%;transform:translateY(-50%);z-index:15;display:flex;flex-direction:column;gap:.7rem}
.idx button{position:relative;width:11px;height:11px;border-radius:50%;border:1.5px solid var(--ink);background:transparent;padding:0;transition:.25s}
.idx button.on{background:var(--ink);transform:scale(1.3)}
.idx button span{position:absolute;right:20px;top:50%;transform:translateY(-50%);white-space:nowrap;background:var(--ink);color:#fff;font:500 .75rem var(--sans);padding:.25rem .6rem;border-radius:99px;opacity:0;pointer-events:none;transition:.2s}
.idx button:hover span{opacity:1}
@media (max-width:1200px){.idx{display:none}}

/* Pasos interactivos */
.stp-t{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.7rem}
.stp-t button{border:1.5px solid var(--c);background:rgba(255,255,255,.7);border-radius:999px;padding:.45rem 1.1rem;font:500 .9rem var(--sans);transition:.25s}
.stp-t button:hover{background:var(--cl)}
.stp-t button[aria-selected="true"]{background:var(--c);box-shadow:0 6px 18px color-mix(in srgb,var(--c) 55%,transparent)}
.stp-bar{height:4px;border-radius:4px;background:var(--line);overflow:hidden;margin-bottom:1rem}
.stp-bar i{display:block;height:100%;background:var(--c);transition:width .6s cubic-bezier(.2,.8,.2,1)}
.stp-p{background:rgba(255,255,255,.75);border:1px solid var(--line);border-radius:24px;padding:1.3rem 1.5rem;animation:pp .5s both;display:grid;grid-template-columns:1fr;gap:1rem}
.stp-p.w{grid-template-columns:minmax(0,1fr) minmax(90px,170px);align-items:center}
.stp-p h3{margin:0 0 .3rem;font:600 1.3rem var(--sans)}
.stp-p p{margin:0;font:500 1.3rem/1.55 var(--serif)}
.stp-p img{width:100%;max-height:200px;object-fit:contain;filter:drop-shadow(0 8px 8px rgba(60,50,120,.25))}
@keyframes pp{from{opacity:0;transform:translateY(10px)}}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem}
.card{background:#fff;border:1px solid var(--line);border-top:4px solid var(--c);border-radius:18px;padding:1.1rem;transition:transform .3s,box-shadow .3s}
.card:hover{transform:translateY(-5px);box-shadow:0 14px 30px rgba(60,50,120,.15)}
.card b{display:block;font:600 1rem var(--sans);margin-bottom:.3rem}
.card p{margin:0;font:500 1.15rem/1.45 var(--serif)}
.enemies{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem}
.en{--k:#9a98b8;background:#fff;border:1px solid var(--line);border-radius:22px;padding:1.1rem;display:flex;flex-direction:column;gap:.5rem;transition:.5s}
.en.healed{border-color:var(--k);box-shadow:0 0 30px color-mix(in srgb,var(--k) 55%,transparent)}
.en.locked{opacity:.6}
.blob{position:relative;width:70px;height:62px;background:#9a98b8;border-radius:46% 54% 50% 50%/58% 56% 44% 42%;animation:wob 4s ease-in-out infinite;transition:background .6s}
@keyframes wob{50%{border-radius:56% 44% 42% 58%/46% 58% 42% 54%;transform:translateY(-4px)}}
.blob i{position:absolute;top:32%;width:10px;height:10px;border-radius:50%;background:#fff;box-shadow:inset 0 -4px 0 #2a2f40;transition:.4s}
.blob i:nth-child(1){left:26%}.blob i:nth-child(2){right:26%}
.blob::after{content:"";position:absolute;left:50%;bottom:18%;width:18px;height:7px;margin-left:-9px;border-radius:0 0 12px 12px;border:2px solid #2a2f40;border-top:0;transform:scaleY(-1);transition:.4s}
.en.healed .blob{background:var(--k)}
.en.healed .blob i{height:4px;border-radius:0 0 10px 10px;box-shadow:none;background:#2a2f40;top:38%}
.en.healed .blob::after{transform:none}
.en h3{margin:0;font:600 1.05rem var(--sans)}
.en p{margin:0;font:500 1.12rem/1.4 var(--serif);color:var(--soft)}
.en .how{min-height:3.4em}
.en button{margin-top:auto;border:0;border-radius:999px;background:var(--ink);color:#fff;padding:.5rem 1rem;font:500 .85rem var(--sans)}
.en.healed button{background:var(--k);color:var(--ink)}
.en button[disabled]{opacity:.55;cursor:default}
.seeds{position:relative;width:min(100%,360px);aspect-ratio:1;margin:1.5rem auto 0;--lit:0}
