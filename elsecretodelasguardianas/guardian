/* ---- Rutas, zoom y portal ---- */
let busy=false;
function cross(b,k){
  if(busy)return;
  if(reduce){location.hash=k;return}
  busy=true;const r=b.getBoundingClientRect(),s=scene.getBoundingClientRect(),col=P[k].c[0];
  scene.style.transformOrigin=`${r.left+r.width/2-s.left}px ${r.top+r.height*.55-s.top}px`;
  home.style.cssText="height:100svh;overflow:hidden";document.body.classList.add("zooming");
  b.classList.add("lit");veil.style.setProperty("--vc",P[k].c[1]);
  burst(r.left+r.width/2,r.top+r.height*.4,col,60);
  scene.classList.add("zoom");veil.classList.add("on");
  setTimeout(()=>{location.hash=k},1180);
}
function portal(k){/* de una puerta a otra, sin volver al inicio */
  if(busy||reduce){location.hash=k;return}
  busy=true;veil.style.setProperty("--vc",P[k].c[1]);veil.classList.add("quick","on");
  const g=document.querySelector(".view:not([hidden]) .gate");if(g){const r=g.getBoundingClientRect(),d=document.createElement("div");d.className="ring";d.style.cssText=`left:${r.left+r.width/2}px;top:${r.top+r.height/2}px;--c:${P[k].c[0]}`;document.body.appendChild(d);setTimeout(()=>d.remove(),1200)}
  setTimeout(()=>{location.hash=k},480);
}
let spy=null;
function route(){
  const id=location.hash.slice(1);
  document.querySelectorAll(".view").forEach(v=>v.hidden=true);
  scene.classList.remove("zoom");veil.classList.remove("on","quick");home.style.cssText="";document.body.classList.remove("zooming");
  AR.forEach(a=>a.classList.remove("lit"));$("prog").hidden=true;spy&&spy.disconnect();
  if(P[id]){
    home.hidden=true;const v=$("v-"+id);v.hidden=false;scrollTo(0,0);
    v.classList.remove("arrive");void v.offsetWidth;v.classList.add("arrive");
    visit(id);$("prog").hidden=false;$("prog").style.setProperty("--pc",P[id].c[0]);
    const dots=[...v.querySelectorAll(".idx button")];
    spy=new IntersectionObserver(es=>es.forEach(en=>{if(en.isIntersecting)dots.forEach(d=>d.classList.toggle("on",d.dataset.sc===en.target.id))}),{rootMargin:"-40% 0px -55% 0px"});
    v.querySelectorAll(".sec").forEach(s=>spy.observe(s));
  }else{
    home.hidden=false;home.classList.remove("back");void home.offsetWidth;home.classList.add("back");
    const t=id&&$(id);if(t)t.scrollIntoView();else scrollTo(0,0);
  }
  busy=false;
}
function go(k){if(P[k]&&!home.hidden===false&&location.hash.slice(1)!==k&&document.querySelector(".view:not([hidden])")){portal(k);return}
  if(location.hash.slice(1)===k)route();else location.hash=k}
document.addEventListener("click",e=>{const g=e.target.closest("[data-go]");if(g)go(g.dataset.go)});
addEventListener("hashchange",route);route();mark(false);
addEventListener("scroll",()=>{const v=document.querySelector(".view:not([hidden])");if(!v)return;const h=document.documentElement.scrollHeight-innerHeight;$("prog").style.width=(h>0?scrollY/h*100:0)+"%"},{passive:true});

